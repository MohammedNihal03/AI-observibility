{
  "name": "@observatory/server",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Fastify API + WebSocket hub for the AI Agent Observatory.",
  "type": "module",
  "main": "./dist/api.js",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.0",
    "@observatory/behavior": "*",
    "@observatory/collectors": "*",
    "@observatory/metrics": "*",
    "@observatory/shared": "*",
    "@observatory/telemetry": "*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "nanoid": "^6.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13"
  },
  "types": "./dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    }
  }
}
